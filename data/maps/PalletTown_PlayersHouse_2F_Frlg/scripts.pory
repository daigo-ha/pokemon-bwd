}

text MCRoom_Text_BiancaWaitingForStarterChoice {
	"Bianca: Ooh!\nWhat kind of Pokémon could they be?"
}

script MCRoom_EventScript_Cheren {
	lock
	faceplayer
	if (var(VAR_LITTLEROOT_START) == 2) {
		msgbox(MCRoom_Text_CherenWaitingForStarterChoice)
	}
	else {
		msgbox("Cheren: Hi {PLAYER}!$")
	}
	release
}

script MCRoom_EventScript_Bianca {
	lock
	faceplayer
	if (var(VAR_LITTLEROOT_START) == 2) {
		msgbox(MCRoom_Text_BiancaWaitingForStarterChoice)
	}
	else {
		msgbox("Bianca: Hi {PLAYER}!$")
	}
	release
}
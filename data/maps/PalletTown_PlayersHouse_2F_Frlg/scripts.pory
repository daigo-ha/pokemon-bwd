mapscripts PalletTown_PlayersHouse_2F_Frlg_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: PalletTown_PlayersHouse_2F_OnTransition
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE: PalletTown_PlayersHouse_2F_OnWarp
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_LITTLEROOT_START, 1: MCRoom_EventScript_Beggining
	]
}

script PalletTown_PlayersHouse_2F_OnTransition {
	if (var(VAR_MAP_SCENE_PALLET_TOWN_PLAYERS_HOUSE_2F) == 0) {
		call(PalletTown_PlayersHouse_2F_EventScript_SetRespawn)
		}
	setvar(VAR_LITTLEROOT_START, 1)
	if (!flag(FLAG_STARTER_BAG)) {
		call(MCRoom_EventScript_StarterBag)
	}
	removeobject(LOCALID_MC2F_BIANCA)
	setflag(FLAG_MC2F_BIANCA)
}

script PalletTown_PlayersHouse_2F_EventScript_SetRespawn {setrespawn(HEAL_LOCATION_PALLET_TOWN)}

script PalletTown_PlayersHouse_2F_OnWarp {
	if (var(VAR_MAP_SCENE_PALLET_TOWN_PLAYERS_HOUSE_2F) == 0) {
		call(PalletTown_PlayersHouse_2F_FirstWarpIn)
	}
}

script PalletTown_PlayersHouse_2F_FirstWarpIn {setvar(VAR_MAP_SCENE_PALLET_TOWN_PLAYERS_HOUSE_2F, 1)}

script PalletTown_PlayersHouse_2F_EventScript_NES {msgbox("{PLAYER} played with the NES.\p…Okay!\nIt's time to go!", MSGBOX_SIGN)}

script PalletTown_PlayersHouse_2F_EventScript_Sign {msgbox("It's a posted notice…\pIf you're confused, ask for HELP!\nPress the L or R Button!", MSGBOX_SIGN)}


script MCRoom_EventScript_Starter{
	while (!(flag(FLAG_STARTER_SNIVY) || flag(FLAG_STARTER_TEPIG) || flag(FLAG_STARTER_OSHAWOTT))){
		lockall
		msgbox("{PLAYER} opened the bag!")
		message("Which starter are you choosing?")
		waitmessage
		multichoice(20, 5, MULTI_STARTER_CHOICE, 0)
		closemessage
		if (var(VAR_RESULT) == 0){
			call(StarterFade)
			call(MCRoom_EventScript_Snivy)
		}
		elif (var(VAR_RESULT) == 1){
			call(StarterFade)
			call(MCRoom_EventScript_Tepig)
		}
		elif (var(VAR_RESULT) == 2){
			call(StarterFade)
			call(MCRoom_EventScript_Oshawott)
		}
		else {
			msgbox("Cheren: Go on. We are waiting...")
			waitmessage
		}
	}
	closemessage
	// else {
	// 	msgbox("The bag is empty.", MSGBOX_DEFAULT)
	// }
	setvar(VAR_LITTLEROOT_START, 3)
	call(MCRoom_EventScript_BattleBianca)
	releaseall
	end
}

script StarterFade {
	fadescreen(FADE_TO_BLACK)
	delay(20)
	fadescreen(FADE_FROM_BLACK)
	return
}

script MCRoom_EventScript_Snivy{
	
	showmonpic(SPECIES_SNIVY, 10, 3)
	msgbox("Are you sure?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES){
		givemon(SPECIES_SNIVY, 5, ITEM_ORAN_BERRY)
		if (var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
			playfanfare(MUS_OBTAIN_ITEM)
			msgbox("Received Snivy")
			removeobject(0)
			setflag(FLAG_STARTER_SNIVY)
            setflag(FLAG_SYS_POKEMON_GET)
			setvar(VAR_STARTER_MON_FRLG, 0)
			call(NicknamePartyMon)
		}
		elif (var(VAR_RESULT) == MON_GIVEN_TO_PC){
			playfanfare(MUS_OBTAIN_ITEM)
			msgbox("Received Snivy")
			removeobject(0)
			setflag(FLAG_STARTER_SNIVY)
            setflag(FLAG_SYS_POKEMON_GET)
			call(NicknameBoxMon)
		}
		else {
			hidemonpic
			msgbox("You have no more room for this Pokemon.")
		}
	}
	else {
		hidemonpic
		msgbox("You did not choose the Pokemon")
	}
	waitmessage
	return
}

